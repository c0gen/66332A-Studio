<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls">
  <Style x:Key="PopupFrame" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="Effect">
      <Setter.Value><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" /></Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
        <Setter Property="Effect" Value="{x:Null}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Style="{StaticResource PopupFrame}" Padding="{TemplateBinding Padding}">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type sys:String}">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Style="{StaticResource PopupFrame}" Padding="4">
            <ScrollViewer MaxHeight="{DynamicResource {x:Static SystemParameters.PrimaryScreenHeightKey}}">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Style.Triggers>
      <Trigger Property="Role" Value="SubmenuItem">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                      CornerRadius="{DynamicResource RadiusControl}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" />
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </DockPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource DisabledInk}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <ContextMenu x:Key="EditorContextMenu" x:Shared="False" Style="{StaticResource {x:Type ContextMenu}}">
    <ContextMenu.Resources>
      <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      </Style>
    </ContextMenu.Resources>
    <MenuItem Header="_Cut" Command="{x:Static ApplicationCommands.Cut}" InputGestureText="Ctrl+X" />
    <MenuItem Header="_Copy" Command="{x:Static ApplicationCommands.Copy}" InputGestureText="Ctrl+C" />
    <MenuItem Header="_Paste" Command="{x:Static ApplicationCommands.Paste}" InputGestureText="Ctrl+V" />
  </ContextMenu>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Action}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="TextElement.FontSize" Value="12" />
    <Setter Property="TextElement.FontWeight" Value="Medium" />
  </Style>

  <Style x:Key="ChipNeutral" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style x:Key="ChipReady" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource ReadySoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ready}" />
  </Style>

  <Style x:Key="ChipWarning" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning}" />
  </Style>

  <Style x:Key="ChipFault" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource FaultSurface}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Fault}" />
  </Style>

  <Style x:Key="ChipAccent" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource ActionSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Action}" />
  </Style>

  <Style x:Key="ChipToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="8,4">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{TemplateBinding Background}" Margin="0,0,6,0" Opacity="0.35" />
              <ContentPresenter RecognizesAccessKey="True" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ActionSoft}" />
              <Setter TargetName="Dot" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledInk}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AckCallout" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style x:Key="EmptyState" TargetType="HeaderedContentControl">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <StackPanel Margin="12,4">
            <Viewbox Width="28" Height="28" Margin="0,0,0,8">
              <Grid Width="16" Height="16">
                <Path Data="{Binding (c:Icon.Geometry), RelativeSource={RelativeSource TemplatedParent}}"
                      Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Grid>
            </Viewbox>
            <TextBlock Text="{TemplateBinding Header}" FontSize="15" FontWeight="Medium" TextAlignment="Center" />
            <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource Muted}" FontSize="12"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
