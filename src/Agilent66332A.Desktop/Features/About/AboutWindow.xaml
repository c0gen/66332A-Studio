<Window x:Class="Agilent66332A.Desktop.Features.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="About 66332A Studio"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Close" Executed="CloseAbout" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OutputOffCommand}" />
  </Window.InputBindings>

  <Border Background="{DynamicResource Enclosure}" Padding="24,20,24,18">
    <StackPanel>
      <DockPanel>
        <Image DockPanel.Dock="Left" Source="/Assets/Studio.ico" Width="44" Height="44"
               Margin="0,0,14,0" IsHitTestVisible="False" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="66332A Studio" Style="{StaticResource PageTitle}" FontSize="22" />
          <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
        </StackPanel>
      </DockPanel>

      <TextBlock Text="Created by Andy Cogen" Style="{StaticResource Title}" Margin="0,18,0,6" />
      <TextBlock Text="Monitor and control an Agilent 66332A over RS-232. Capture waveforms, log measurements, and run sequences."
                 TextWrapping="Wrap" />
      <TextBlock Text="Try the simulator without a connected instrument."
                 Style="{StaticResource MutedText}" Margin="0,8,0,0" />

      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Command="ApplicationCommands.Close"
                  MinWidth="76" Margin="12,0,0,0" />
          <TextBlock Text="Built with WPF, ScottPlot, and IBM Plex." Style="{StaticResource Caption}" />
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
