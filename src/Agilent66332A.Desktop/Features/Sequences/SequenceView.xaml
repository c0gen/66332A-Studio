<UserControl x:Class="Agilent66332A.Desktop.Features.Sequences.SequenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls"
             xmlns:local="clr-namespace:Agilent66332A.Desktop.Features.Sequences">
  <UserControl.Resources>
    <Style x:Key="NumericCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="NumericCellEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style x:Key="StepRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
      <Setter Property="FontWeight" Value="Normal" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Selected}" />
          <Setter Property="AutomationProperties.ItemStatus" Value="Active step" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StepNameCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Ready}" />
          <Setter Property="BorderThickness" Value="3,0,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="CenteredHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="StepOutput" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="StepOutputEditor" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid DataContext="{Binding Sequences}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource PanelFrame}" Padding="16,12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <Label Content="Name" Target="{Binding ElementName=SequenceName}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SequenceName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Sequence name" IsReadOnly="{Binding IsLocked}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Label Content="Repeats" Target="{Binding ElementName=Repeats}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="Repeats" Text="{Binding Repeats, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource MonoFont}" TextAlignment="Right" IsReadOnly="{Binding IsLocked}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button Content="Validate" Command="{Binding ValidateCommand}" Style="{StaticResource GhostButton}" />
            <Button Content="Run sequence" c:Icon.Geometry="{StaticResource IconPlay}" Command="{Binding RunCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
            <Button Content="Stop run" c:Icon.Geometry="{StaticResource IconStop}"
                    Command="{Binding DataContext.OutputOffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    IsEnabled="{Binding RunCommand.IsRunning}" ToolTip="Stop the run and verify output off."
                    Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
          </StackPanel>
        </Grid>

        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button Content="Open" c:Icon.Geometry="{StaticResource IconFolder}" Command="{Binding OpenCommand}" />
            <Button Content="Save" c:Icon.Geometry="{StaticResource IconSave}" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
          </StackPanel>
          <StackPanel>
            <Label Content="JSON file" Target="{Binding ElementName=SequenceFile}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SequenceFile" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsLocked}" AutomationProperties.Name="Sequence JSON file path" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Margin="0,12,0,0">
      <ScrollViewer x:Name="StepScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Height="{Binding ViewportHeight, ElementName=StepScroller}" MinHeight="248">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel Margin="16,8">
              <Border DockPanel.Dock="Right" Style="{StaticResource ChipWarning}" Margin="12,0,0,0"
                      Visibility="{Binding IsDirty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="Unsaved changes" />
              </Border>
              <TextBlock DockPanel.Dock="Left" Text="Preview" Style="{StaticResource Title}" Margin="0,0,12,0" />
              <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" />
            </DockPanel>
            <local:SequencePreview />
            <TextBlock Text="{Binding Validation}" Style="{StaticResource OptionalCaption}"
                       Margin="16,4,16,8" MaxHeight="45" TextTrimming="CharacterEllipsis" ToolTip="{Binding Validation}"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="{Binding IsLocked}"
                    RowStyle="{StaticResource StepRow}" AutomationProperties.Name="Sequence steps">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Step" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                  CellStyle="{StaticResource StepNameCell}" ElementStyle="{StaticResource TableText}" Width="*" />
              <DataGridTextColumn Header="Voltage (V)" Binding="{Binding VoltageV, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource NumericCell}"
                                  EditingElementStyle="{StaticResource NumericCellEditor}" Width="140" />
              <DataGridTextColumn Header="Limit (A)" Binding="{Binding CurrentLimitA, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource NumericCell}"
                                  EditingElementStyle="{StaticResource NumericCellEditor}" Width="140" />
              <DataGridCheckBoxColumn Header="Output on" HeaderStyle="{StaticResource CenteredHeader}" Binding="{Binding OutputEnabled, UpdateSourceTrigger=PropertyChanged}"
                                      ElementStyle="{StaticResource StepOutput}" EditingElementStyle="{StaticResource StepOutputEditor}" Width="120" />
              <DataGridTextColumn Header="Hold (s)" Binding="{Binding HoldSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                  HeaderStyle="{StaticResource NumberHeader}" ElementStyle="{StaticResource NumericCell}"
                                  EditingElementStyle="{StaticResource NumericCellEditor}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <WrapPanel>
              <Button Content="Add step" c:Icon.Geometry="{StaticResource IconPlus}" Command="{Binding AddCommand}" />
              <Button Content="Duplicate" Style="{StaticResource GhostButton}" c:Icon.Geometry="{StaticResource IconCopy}" Command="{Binding DuplicateCommand}" Margin="8,0,0,0" />
              <Button Content="Move up" Style="{StaticResource GhostButton}" c:Icon.Geometry="{StaticResource IconArrowUp}" Command="{Binding MoveUpCommand}" Margin="8,0,0,0" />
              <Button Content="Move down" Style="{StaticResource GhostButton}" c:Icon.Geometry="{StaticResource IconArrowDown}" Command="{Binding MoveDownCommand}" Margin="8,0,0,0" />
              <Button Content="Delete" Style="{StaticResource DestructiveGhostButton}" c:Icon.Geometry="{StaticResource IconTrash}" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
            </WrapPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource PanelFrame}" Padding="16,8" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" />
        <ProgressBar Maximum="1" Value="{Binding HoldFraction}" Margin="0,8,0,0" AutomationProperties.Name="Current hold progress" />
        <TextBlock Text="{Binding RunResult}" Style="{StaticResource OptionalCaption}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
