<UserControl x:Class="Agilent66332A.Desktop.Features.Capture.TransientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource FormCard}" MaxWidth="680" HorizontalAlignment="Left">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Read pending levels" c:Icon.Geometry="{StaticResource IconRefresh}"
                  Command="{Binding ReadLevelsCommand}" VerticalAlignment="Top" Margin="8,0,0,0" />
          <StackPanel>
            <TextBlock Text="Triggered output levels" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Readback}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </DockPanel>
        <TextBlock Text="Stage the voltage and current limit that the supply applies when you fire a trigger."
                   Style="{StaticResource Caption}" Margin="0,0,0,12" />
        <StackPanel IsEnabled="{Binding IsEditable}">
          <HeaderedContentControl Style="{StaticResource FormField}">
            <HeaderedContentControl.Header>
              <Label Content="Pending voltage (V)" Style="{StaticResource FieldLabel}" />
            </HeaderedContentControl.Header>
            <TextBox Text="{Binding Voltage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pending voltage in volts" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource FormField}">
            <HeaderedContentControl.Header>
              <Label Content="Pending current limit (A)" Style="{StaticResource FieldLabel}" />
            </HeaderedContentControl.Header>
            <TextBox Text="{Binding Current, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pending current limit in amps" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource FormField}">
            <HeaderedContentControl.Header>
              <Label Content="Fire method" Style="{StaticResource FieldLabel}" />
            </HeaderedContentControl.Header>
            <ComboBox ItemsSource="{Binding Triggers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Trigger}" AutomationProperties.Name="Output trigger method" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource FormField}">
            <HeaderedContentControl.Header>
              <Label Content="Wait (s)" Style="{StaticResource FieldLabel}" />
            </HeaderedContentControl.Header>
            <TextBox Text="{Binding WaitSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output trigger wait in seconds" />
          </HeaderedContentControl>
          <CheckBox Content="Rearm after each trigger" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Continuous}" Margin="0,0,0,10" />
        </StackPanel>
        <WrapPanel>
          <Button Content="Arm" c:Icon.Geometry="{StaticResource IconPlay}" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
          <Button Content="Fire trigger" c:Icon.Geometry="{StaticResource IconBolt}" Command="{Binding FireCommand}" Margin="0,0,8,0" />
          <Button Command="{Binding AbortCommand}" c:Icon.Geometry="{StaticResource IconStop}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Content" Value="Abort pending triggers" />
                <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter Property="Content" Value="Stop and turn off" />
                </DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </WrapPanel>
        <TextBlock Text="{Binding Availability}" Style="{StaticResource OptionalCaption}" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
