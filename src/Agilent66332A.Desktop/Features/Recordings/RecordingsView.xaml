<UserControl x:Class="Agilent66332A.Desktop.Features.Recordings.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls"
             xmlns:local="clr-namespace:Agilent66332A.Desktop.Features.Recordings">
  <UserControl.Resources>
    <local:RecordingTimeConverter x:Key="RecordingTime" />
    <c:ContainsConverter x:Key="OutcomePrefix" MatchStart="True" />
    <Style x:Key="RecordedTime" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="ToolTip" Value="{Binding StartedUtc}" />
    </Style>
    <Style x:Key="OutcomeChip" TargetType="Border" BasedOn="{StaticResource ChipFault}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Outcome, Converter={StaticResource OutcomePrefix}, ConverterParameter=Completed}" Value="True">
          <Setter Property="Background" Value="{DynamicResource ReadySoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Ready}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Outcome, Converter={StaticResource OutcomePrefix}, ConverterParameter=Cancelled}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShutdownChip" TargetType="Border" BasedOn="{StaticResource ChipNeutral}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Shutdown}" Value="VerifiedOff">
          <Setter Property="Background" Value="{DynamicResource ReadySoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Ready}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Shutdown}" Value="Unverified">
          <Setter Property="Background" Value="{DynamicResource FaultSurface}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Fault}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShutdownResult" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
      <Setter Property="Text" Value="{Binding Shutdown}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Shutdown}" Value="VerifiedOff">
          <Setter Property="Text" Value="Verified off" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SourceChip" TargetType="Border" BasedOn="{StaticResource ChipNeutral}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SourceKind}" Value="Simulator">
          <Setter Property="Background" Value="{DynamicResource ActionSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Action}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource PanelFrame}" Padding="16" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Recordings}"
                    VerticalAlignment="Bottom" Margin="8,0,0,0">
          <Button Content="Refresh" Style="{StaticResource GhostButton}" c:Icon.Geometry="{StaticResource IconRefresh}" Command="{Binding RefreshCommand}" />
          <Button Content="Open folder" c:Icon.Geometry="{StaticResource IconFolder}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel>
          <Label Content="Save to" Target="{Binding ElementName=RecordingDirectory}" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="RecordingDirectory" Text="{Binding RecordingDirectory, UpdateSourceTrigger=LostFocus}"
                   AutomationProperties.Name="Recording directory" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource PanelFrame}" Background="{DynamicResource Well}" Padding="1,1,1,6">
      <Grid DataContext="{Binding Recordings}">
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutomationProperties.Name="Recent recordings">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Recording" Binding="{Binding Name}" ElementStyle="{StaticResource TableText}" Width="*" MinWidth="150" />
            <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedUtc, Converter={StaticResource RecordingTime}}"
                                ElementStyle="{StaticResource RecordedTime}" Width="206" />
            <DataGridTemplateColumn Header="Outcome" Width="206">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource OutcomeChip}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource TableText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Shutdown" Width="122">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ShutdownChip}" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource ShutdownResult}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Source" Width="108">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SourceChip}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SourceKind}" Style="{StaticResource TableText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <HeaderedContentControl Header="No recordings yet" Content="Start a recording on Monitor or run a sequence."
                               c:Icon.Geometry="{StaticResource IconRecordings}">
          <HeaderedContentControl.Style>
            <Style TargetType="HeaderedContentControl" BasedOn="{StaticResource EmptyState}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </HeaderedContentControl.Style>
        </HeaderedContentControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
