<UserControl x:Class="Agilent66332A.Desktop.Controls.StatusBadge" x:Name="Root" Background="{DynamicResource SurfaceRaised}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{Binding Background, ElementName=Root}"
          CornerRadius="11" Padding="8,2" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
      <Ellipse Fill="{Binding Foreground, ElementName=Root}" Width="6" Height="6" Margin="0,0,7,0" />
      <TextBlock Text="{Binding Text, ElementName=Root}" Foreground="{Binding Foreground, ElementName=Root}" FontSize="12" FontWeight="Medium" />
    </StackPanel>
  </Border>
</UserControl>
