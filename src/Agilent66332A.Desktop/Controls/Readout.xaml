<UserControl x:Class="Agilent66332A.Desktop.Controls.Readout" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls">
  <AutomationProperties.Name>
    <MultiBinding StringFormat="{}{0}: {1} {2}">
      <Binding Path="Label" ElementName="Root" />
      <Binding Path="Value" ElementName="Root" />
      <Binding Path="Unit" ElementName="Root" />
    </MultiBinding>
  </AutomationProperties.Name>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Ellipse Fill="{Binding Accent, ElementName=Root}" Width="8" Height="8"
                 VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBlock Text="{Binding Label, ElementName=Root}" Foreground="{DynamicResource Muted}" FontSize="13" FontWeight="Medium" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
      <c:SegmentDisplay Text="{Binding Value, ElementName=Root}" DigitSize="{Binding DigitSize, ElementName=Root}"
                        Placeholder="{Binding Placeholder, ElementName=Root}" MinIntegerDigits="{Binding MinIntegerDigits, ElementName=Root}"
                        Foreground="{Binding Accent, ElementName=Root}" IdleBrush="{DynamicResource DisabledInk}" FontFamily="{StaticResource MeasurementFont}" />
      <TextBlock Text="{Binding Unit, ElementName=Root}" Foreground="{Binding Accent, ElementName=Root}"
                 FontSize="20" FontWeight="Medium" Opacity="0.8" VerticalAlignment="Bottom" Margin="8,0,0,6" />
    </StackPanel>
    <TextBlock Grid.Row="2" Text="{Binding Detail, ElementName=Root}" Style="{StaticResource Caption}"
               Foreground="{Binding Foreground, ElementName=Root}" />
  </Grid>
</UserControl>
