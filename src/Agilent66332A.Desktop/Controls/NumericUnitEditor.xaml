<UserControl x:Class="Agilent66332A.Desktop.Controls.NumericUnitEditor" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="136" />
    </Grid.ColumnDefinitions>
    <Label Content="{Binding Label, ElementName=Root}" Target="{Binding ElementName=Editor}" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="Editor" Grid.Column="1" Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
             TextAlignment="Right" Height="40" FontSize="15" FontFamily="{StaticResource MonoFont}" Padding="8,5,32,5"
             AutomationProperties.Name="{Binding Label, ElementName=Root}" />
    <TextBlock Grid.Column="1" Text="{Binding Unit, ElementName=Root}" Foreground="{DynamicResource Muted}"
               HorizontalAlignment="Right" FontSize="13" Width="24" TextAlignment="Center" IsHitTestVisible="False" />
  </Grid>
</UserControl>
