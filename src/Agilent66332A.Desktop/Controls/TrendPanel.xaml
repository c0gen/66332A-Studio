<UserControl x:Class="Agilent66332A.Desktop.Controls.TrendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
  <Border Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="4,5,6,0">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="VoltageRow" />
          <RowDefinition x:Name="CurrentRow" />
          <RowDefinition x:Name="PowerRow" Height="0" />
        </Grid.RowDefinitions>
        <DockPanel ClipToBounds="True">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,0">
            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource Voltage}" />
            <TextBlock Text="Voltage · V" Style="{StaticResource Caption}" FontWeight="Medium" />
          </StackPanel>
          <plot:WpfPlot x:Name="VoltagePlot" AutomationProperties.Name="Voltage trend in volts" />
        </DockPanel>
        <DockPanel Grid.Row="1" ClipToBounds="True">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,0">
            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource Current}" />
            <TextBlock Text="Current · A" Style="{StaticResource Caption}" FontWeight="Medium" />
          </StackPanel>
          <plot:WpfPlot x:Name="CurrentPlot" AutomationProperties.Name="Current trend in amperes" />
        </DockPanel>
        <DockPanel Grid.Row="2" ClipToBounds="True">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,0">
            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource Ink}" />
            <TextBlock Text="Power estimate · W" Style="{StaticResource Caption}" FontWeight="Medium" />
          </StackPanel>
          <plot:WpfPlot x:Name="PowerPlot" AutomationProperties.Name="Estimated power trend in watts" />
        </DockPanel>
      </Grid>
      <TextBlock x:Name="NoChannels" Text="Select a channel to plot." Style="{StaticResource MutedText}"
                 HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />

      <Border Grid.Row="1" Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}"
              BorderThickness="0,1,0,0" Padding="12,0" Height="28">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="Dashed setpoints, dotted events" Style="{StaticResource Caption}"
                     Margin="12,0,0,0" />
          <TextBlock x:Name="CursorText" Style="{StaticResource Caption}" Text="Hover to inspect samples"
                     FontFamily="{StaticResource MonoFont}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
