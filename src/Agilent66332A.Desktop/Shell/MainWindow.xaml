<Window x:Class="Agilent66332A.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls"
        xmlns:shell="clr-namespace:Agilent66332A.Desktop.Shell"
        xmlns:model="clr-namespace:Agilent66332A.Core.Models;assembly=Agilent66332A.Core"
        xmlns:monitor="clr-namespace:Agilent66332A.Desktop.Features.Monitor"
        xmlns:sequences="clr-namespace:Agilent66332A.Desktop.Features.Sequences"
        xmlns:recordings="clr-namespace:Agilent66332A.Desktop.Features.Recordings"
        xmlns:diagnostics="clr-namespace:Agilent66332A.Desktop.Features.Diagnostics"
        xmlns:capture="clr-namespace:Agilent66332A.Desktop.Features.Capture"
        xmlns:setup="clr-namespace:Agilent66332A.Desktop.Features.InstrumentSetup"
        xmlns:service="clr-namespace:Agilent66332A.Desktop.Features.Service"
        Style="{StaticResource {x:Type Window}}" Title="66332A Studio" Width="1440" Height="900"
        MinWidth="1000" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OutputOffCommand}" />
    <KeyBinding Key="Escape" Command="{Binding Manual.RestoreCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <Style x:Key="ConnectionPill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static model:ConnectionState.Connecting}">
          <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static model:ConnectionState.Ready}">
          <Setter Property="Foreground" Value="{DynamicResource Ready}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static model:ConnectionState.Lost}">
          <Setter Property="Foreground" Value="{DynamicResource Fault}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusFooter" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Well}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static model:ConnectionState.Lost}">
          <Setter Property="BorderBrush" Value="{DynamicResource FaultLine}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding CloseUnverified}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Fault}" />
          <Setter Property="Background" Value="{DynamicResource FaultSurface}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource Enclosure}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="76" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Viewbox Width="32" Height="32" Margin="0,12,0,8" IsHitTestVisible="False">
          <Grid Width="64" Height="64">
            <Rectangle RadiusX="14" RadiusY="14" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Line}" StrokeThickness="2" />
            <Path Data="M10,39 H21 V23 H43 V39 H54" Stroke="{DynamicResource Voltage}" StrokeThickness="4" StrokeLineJoin="Round" />
            <Path Data="M10,49.5 H54" Stroke="{DynamicResource Current}" StrokeThickness="3" />
          </Grid>
        </Viewbox>
        <ListBox x:Name="WorkspaceNav" Grid.Row="1" VerticalAlignment="Top"
                 Style="{StaticResource NavRail}" AutomationProperties.Name="Workspaces"
                 SelectedIndex="{Binding SelectedIndex, ElementName=WorkspaceTabs, Mode=TwoWay, FallbackValue=0}">
          <ListBoxItem Content="Monitor" c:Icon.Geometry="{StaticResource IconMonitor}" />
          <ListBoxItem Content="Sequences" c:Icon.Geometry="{StaticResource IconSequence}" />
          <ListBoxItem Content="Recordings" c:Icon.Geometry="{StaticResource IconRecordings}" />
          <ListBoxItem Content="Diagnostics" c:Icon.Geometry="{StaticResource IconDiagnostics}" />
          <ListBoxItem Content="Capture" c:Icon.Geometry="{StaticResource IconCapture}" />
          <ListBoxItem Content="Setup" ToolTip="Instrument Setup" AutomationProperties.Name="Instrument Setup" c:Icon.Geometry="{StaticResource IconSetup}" />
          <ListBoxItem Content="Service" c:Icon.Geometry="{StaticResource IconService}" />
        </ListBox>
        <Button Grid.Row="2" Content="About" Style="{StaticResource GhostButton}"
                FontSize="12" MinHeight="32" Padding="6,4" Margin="6,0,6,8"
                ToolTip="About 66332A Studio" Click="OpenAbout" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="20,0,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>

      <DockPanel Margin="0,8,0,12" MinHeight="44">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ConnectionButton" Style="{StaticResource ConnectionPill}"
                  Padding="12,5" ToolTip="{Binding ProfileLabel, StringFormat='Open connection settings ({0})'}" Margin="0,0,12,0"
                  AutomationProperties.Name="{Binding ConnectionLabel, StringFormat='Connection settings, {0}'}"
                  Click="OpenConnectionSettings">
            <Button.Resources>
              <CornerRadius x:Key="RadiusControl">18</CornerRadius>
            </Button.Resources>
            <StackPanel Orientation="Horizontal">
              <Grid Width="8" Height="8" Margin="0,0,8,0">
                <Ellipse x:Name="ConnectionPulse" Fill="{Binding Foreground, ElementName=ConnectionButton}"
                         RenderTransformOrigin="0.5,0.5" Opacity="0">
                  <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Fill="{Binding Foreground, ElementName=ConnectionButton}" />
              </Grid>
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding Foreground, ElementName=ConnectionButton}" />
              <Path Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center"
                    Data="M7,2 H10 V5 M10,2 L5.5,6.5 M5,2.5 H2.5 V9.5 H9.5 V7"
                    Stroke="{Binding Foreground, ElementName=ConnectionButton}" StrokeThickness="1.25"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </StackPanel>
          </Button>
          <Button x:Name="OutputControlButton" Style="{StaticResource OutputToggleButton}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="66332A Studio" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding IdentityLabel}" Style="{StaticResource OptionalCaption}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityLabel}" />
        </StackPanel>
      </DockPanel>

      <shell:InstrumentDisplay x:Name="MeasurementDisplay" Grid.Row="1" Margin="0,0,0,12" />
      <c:WorkspaceTabControl x:Name="WorkspaceTabs" AutomationProperties.Name="Workspace" SelectedIndex="0" Grid.Row="2" Style="{StaticResource HeaderlessTabs}" SelectionChanged="WorkspaceChanged">
        <TabItem Header="Monitor"><monitor:MonitorView /></TabItem>
        <TabItem Header="Sequences"><sequences:SequenceView /></TabItem>
        <TabItem Header="Recordings"><recordings:RecordingsView /></TabItem>
        <TabItem Header="Diagnostics"><diagnostics:DiagnosticsView /></TabItem>
        <TabItem Header="Capture"><capture:CaptureView DataContext="{Binding Capture}" /></TabItem>
        <TabItem Header="Instrument Setup"><setup:InstrumentSetupView /></TabItem>
        <TabItem Header="Service"><service:ServiceView /></TabItem>
      </c:WorkspaceTabControl>

    </Grid>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource StatusFooter}" Padding="16,4" MinHeight="32">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close with output unverified" Click="AcknowledgeClose"
                c:Icon.Geometry="{StaticResource IconStop}" Style="{StaticResource DangerButton}" Margin="16,0,0,0"
                Visibility="{Binding CloseUnverified, Converter={StaticResource BoolVisibility}}" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Footer}" Style="{StaticResource OptionalCaption}" MaxWidth="380"
                   TextAlignment="Right" Margin="16,0,0,0" />
        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{Binding Foreground, ElementName=ConnectionButton}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CloseUnverified}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource Fault}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
</Window>

