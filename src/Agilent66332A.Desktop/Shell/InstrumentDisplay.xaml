<UserControl x:Class="Agilent66332A.Desktop.Shell.InstrumentDisplay" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Agilent66332A.Desktop.Controls"
             xmlns:model="clr-namespace:Agilent66332A.Core.Models;assembly=Agilent66332A.Core">
  <UserControl.Resources>
    <Style x:Key="Channel" TargetType="c:Readout">
      <Setter Property="DigitSize" Value="64" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
          <Setter Property="DigitSize" Value="44" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Estimate" TargetType="c:Readout" BasedOn="{StaticResource Channel}">
      <Setter Property="DigitSize" Value="44" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
          <Setter Property="DigitSize" Value="32" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ChannelEdge" TargetType="Border">
      <Setter Property="Height" Value="2" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Visibility" Value="Hidden" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static model:ConnectionState.Ready}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Annunciator" TargetType="Border" BasedOn="{StaticResource ChipNeutral}">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style x:Key="AnnunciatorText" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource PanelFrame}" Background="{DynamicResource DisplayWell}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition Width="0.86*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="16,8">
          <Grid>
            <Border Style="{StaticResource ChannelEdge}" Background="{DynamicResource Voltage}" />
            <c:Readout Label="Voltage" Value="{Binding VoltageValue}" Unit="V" Detail="{Binding VoltageDetail}"
                       Placeholder="-.----" MinIntegerDigits="2" Accent="{DynamicResource Voltage}"
                       Style="{StaticResource Channel}" Margin="0,8,0,0" />
          </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="16,8">
          <Grid>
            <Border Style="{StaticResource ChannelEdge}" Background="{DynamicResource Current}" />
            <c:Readout Label="Current" Value="{Binding CurrentValue}" Unit="A" Detail="{Binding CurrentDetail}"
                       Placeholder="-.-----" MinIntegerDigits="1" Accent="{DynamicResource Current}"
                       Style="{StaticResource Channel}" Margin="0,8,0,0" />
          </Grid>
        </Border>
        <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="16,8">
          <Grid>
            <Border Style="{StaticResource ChannelEdge}" Background="{DynamicResource Ink}" />
            <c:Readout Label="Power estimate" Value="{Binding PowerValue}" Unit="W"
                       Placeholder="-.----" MinIntegerDigits="3" Accent="{DynamicResource Ink}"
                       Style="{StaticResource Estimate}" Margin="0,8,0,0" />
          </Grid>
        </Border>
        <Border Grid.Column="3" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="16,8">
          <Grid VerticalAlignment="Center" AutomationProperties.Name="{Binding OutputLabel}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border>
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ChipNeutral}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OutputStatus}" Value="{x:Static model:OutputState.On}">
                      <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OutputStatus}" Value="{x:Static model:OutputState.Unknown}">
                      <Setter Property="Background" Value="{DynamicResource FaultSurface}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Fault}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource AnnunciatorText}">
                    <Setter Property="Text" Value="OUTPUT ?" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding OutputStatus}" Value="{x:Static model:OutputState.Off}">
                        <Setter Property="Text" Value="OUTPUT OFF" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding OutputStatus}" Value="{x:Static model:OutputState.On}">
                        <Setter Property="Text" Value="OUTPUT ON" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <Border Grid.Column="2">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Annunciator}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OutputStatus}" Value="{x:Static model:OutputState.On}">
                      <Setter Property="Opacity" Value="1" />
                      <Setter Property="Background" Value="{DynamicResource ActionSoft}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Action}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource AnnunciatorText}">
                    <Setter Property="Text" Value="CV" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding OutputStatus}" Value="{x:Static model:OutputState.On}">
                        <Setter Property="Text" Value="{Binding RegulationMode}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <Border Grid.Row="2">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Annunciator}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasFault}" Value="True">
                      <Setter Property="Opacity" Value="1" />
                      <Setter Property="Background" Value="{DynamicResource FaultSurface}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Fault}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="PROT" Style="{StaticResource AnnunciatorText}" />
            </Border>
            <Border Grid.Row="2" Grid.Column="2">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Annunciator}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSimulator}" Value="True">
                      <Setter Property="Opacity" Value="1" />
                      <Setter Property="Background" Value="{DynamicResource ActionSoft}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Action}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="SIM" Style="{StaticResource AnnunciatorText}" />
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding LastKnown}" Style="{StaticResource OptionalCaption}"
                     Foreground="{DynamicResource Warning}" Margin="16,0,0,0" TextAlignment="Right" />
          <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,8,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource Warning}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFresh}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Ready}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding AgeLabel}" Style="{StaticResource Caption}"
                     ToolTip="Voltage and current are sampled separately." />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
