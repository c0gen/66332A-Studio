<Window x:Class="Agilent66332A.Desktop.Shell.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Agilent66332A.Desktop.Shell"
        Style="{StaticResource {x:Type Window}}" Title="Connection settings"
        Width="780" Height="620" MinWidth="620" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OutputOffCommand}" />
  </Window.InputBindings>

  <DockPanel Background="{DynamicResource Enclosure}">
    <DockPanel DockPanel.Dock="Top" Margin="16,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource OutputOffButton}" Margin="12,0,0,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource Caption}" />
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="16,8" MinHeight="36">
      <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" ToolTip="{Binding Message}"
                 MaxHeight="48" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,0,8,12">
      <shell:ConnectionPanel Margin="0,0,8,0" />
    </ScrollViewer>
  </DockPanel>
</Window>
